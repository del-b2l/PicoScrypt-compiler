// tomb.pico - two-room puzzle using inv condition
// tests: inv has, on enter lose, multi-item player

world Tomb:
    flag sarcophagus_open = false

    player:
        inv torch
        inv scarab
    end

    item torch:
        examine: "A flickering wooden torch."

        use:
            lose "The torch goes out. Something ancient stirs in the darkness."
        end
    end

    item scarab:
        examine: "A golden scarab amulet."

        use:
            say "The scarab glows and fits into the door."
        end
    end

    room antechamber:
        go east -> burial_chamber requires flag sarcophagus_open
    end

    room burial_chamber:
        on enter:
            win "The pharaoh sleeps peacefully. The treasure is yours!"
        end
    end

    puzzle gate:
        room antechamber
        requires inv has scarab
        unlock sarcophagus_open
    end

end